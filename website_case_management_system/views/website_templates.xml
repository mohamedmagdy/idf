<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website Menu -->
    <record id="menu_case_submission" model="website.menu">
        <field name="name">Case</field>
        <field name="url">/case/form</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">50</field>
    </record>

    <!-- Landing Page Template -->
    <template id="case_landing_page" name="Case Landing Page">
        <t t-call="website.layout">
            <div class="oe_structure">
                <!-- Hero Banner Section -->
                <section class="s_banner parallax s_parallax_is_fixed bg-black-50 pt96 pb96" data-scroll-background-ratio="1">
                    <span class="s_parallax_bg oe_img_bg" style="background-image: url('/website_case_management_system/static/src/img/banner.jpg');"/>
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12 text-center">
                                <h1 class="text-white mb32">Empowering Your Business Journey</h1>
                                <p class="lead text-white mb32">
                                    We support innovative entrepreneurs and startups through our comprehensive case management system. 
                                    Get the funding and guidance you need to turn your vision into reality.
                                </p>
                                <a href="/submit-case" class="btn btn-primary btn-lg">Apply Now</a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Features Section -->
                <section class="pt48 pb32">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4 text-center mb32">
                                <i class="fa fa-money fa-3x text-primary mb16"></i>
                                <h3>Funding Support</h3>
                                <p>Access to financial resources to help grow your business</p>
                            </div>
                            <div class="col-lg-4 text-center mb32">
                                <i class="fa fa-lightbulb-o fa-3x text-primary mb16"></i>
                                <h3>Innovation Focus</h3>
                                <p>Support for innovative ideas and solutions</p>
                            </div>
                            <div class="col-lg-4 text-center mb32">
                                <i class="fa fa-users fa-3x text-primary mb16"></i>
                                <h3>Expert Guidance</h3>
                                <p>Professional mentorship and business advice</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Process Section -->
                <section class="bg-light pt48 pb32">
                    <div class="container">
                        <h2 class="text-center mb32">How It Works</h2>
                        <div class="row">
                            <div class="col-lg-3 text-center mb32">
                                <div class="h1 text-primary">1</div>
                                <h4>Apply</h4>
                                <p>Submit your application with project details</p>
                            </div>
                            <div class="col-lg-3 text-center mb32">
                                <div class="h1 text-primary">2</div>
                                <h4>Review</h4>
                                <p>Our team evaluates your application</p>
                            </div>
                            <div class="col-lg-3 text-center mb32">
                                <div class="h1 text-primary">3</div>
                                <h4>Qualify</h4>
                                <p>Successful applications move to qualification</p>
                            </div>
                            <div class="col-lg-3 text-center mb32">
                                <div class="h1 text-primary">4</div>
                                <h4>Support</h4>
                                <p>Receive funding and ongoing support</p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <!-- Case Submission Form Template -->
    <template id="case_submission_form" name="Case Submission Form">
    <t t-call="website.layout">
        <div id="wrap">
            <div class="container mt32 mb32">
                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="text-center mb32">Submit Your Case</h1>
                        <form action="/submit-case" method="post" class="o_website_form" enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            
                            <!-- Applicant Information -->
                            <h3 class="mb-3">Personal Information</h3>
                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="contact_name">Your Full Name</label>
                                    <label for="contact_name" class="d-block">الاسم الثلاثي</label>
                                </div>
                                <input type="text" class="form-control" name="contact_name" required="required"/>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="contact_email">Email Address</label>
                                    <label for="contact_email" class="d-block">البريد الإلكتروني</label>
                                </div>
                                <input type="email" class="form-control" name="contact_email" required="required"/>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="contact_phone">Phone Number</label>
                                    <label for="contact_phone" class="d-block">رقم الهاتف</label>
                                </div>
                                <input type="tel" class="form-control" name="contact_phone" required="required"/>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="contact_age">Age</label>
                                    <label for="contact_age" class="d-block">العمر</label>
                                </div>
                                <input type="number" class="form-control" name="contact_age" required="required"/>
                            </div>
                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="project_name">Project Name</label>
                                    <label for="project_name" class="d-block">اسم المشروع</label>
                                </div>
                                <input type="text" class="form-control" name="project_name" required="required"/>
                            </div>    
                            <!-- Project Information -->
                            <h3 class="mb-3 mt-4">General Information &amp; Idea Description </h3>
                            
                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="project_description">Describe your Business</label>
                                    <label for="project_description" class="d-block">اوصف طبيعة عمل الشركة</label>
                                </div>
                                <textarea class="form-control" name="project_description" rows="4" required="required"></textarea>
                            </div>

                            <!-- Business Information -->
                            <h3 class="mb-3 mt-4">Business Information</h3>
                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="business_nature">Business Nature</label>
                                    <label for="business_nature" class="d-block">طبيعة العمل</label>
                                </div>
                                <textarea class="form-control" name="business_nature" rows="3"></textarea>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="business_model">Business Model</label>
                                    <label for="business_model" class="d-block">نموذج العمل</label>
                                </div>
                                <textarea class="form-control" name="business_model" rows="3"></textarea>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="business_registration_type">Business Registration Type</label>
                                    <label for="business_registration_type" class="d-block">نوع تسجيل الشركة</label>
                                </div>
                                <input type="text" class="form-control" name="business_registration_type"/>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="company_registration_date">Company Registration Date</label>
                                    <label for="company_registration_date" class="d-block">تاريخ تسجيل الشركة</label>
                                </div>
                                <input type="date" class="form-control" name="company_registration_date"/>
                            </div>

                            <!-- Market Analysis -->
                            <h3 class="mb-3 mt-4">Market Analysis</h3>
                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="sector_category">Sector Category</label>
                                    <label for="sector_category" class="d-block">فئة القطاع</label>
                                </div>
                                <input type="text" class="form-control" name="sector_category"/>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="target_audience">Target Audience</label>
                                    <label for="target_audience" class="d-block">الجمهور المستهدف</label>
                                </div>
                                <textarea class="form-control" name="target_audience" rows="3"></textarea>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="competitive_advantage">Competitive Advantage</label>
                                    <label for="competitive_advantage" class="d-block">الميزة التنافسية</label>
                                </div>
                                <textarea class="form-control" name="competitive_advantage" rows="3"></textarea>
                            </div>

                            <!-- Business Operations -->
                            <h3 class="mb-3 mt-4">Business Operations</h3>
                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="offered_services">Offered Services</label>
                                    <label for="offered_services" class="d-block">الخدمات المقدمة</label>
                                </div>
                                <textarea class="form-control" name="offered_services" rows="3"></textarea>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="problems_to_be_solved">Problems to be Solved</label>
                                    <label for="problems_to_be_solved" class="d-block">المشاكل المراد حلها</label>
                                </div>
                                <textarea class="form-control" name="problems_to_be_solved" rows="3"></textarea>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="challenges">Challenges</label>
                                    <label for="challenges" class="d-block">التحديات</label>
                                </div>
                                <textarea class="form-control" name="challenges" rows="3"></textarea>
                            </div>

                            <!-- Financial Information -->
                            <h3 class="mb-3 mt-4">Financial Information</h3>
                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="business_start_date">Business Start Date</label>
                                    <label for="business_start_date" class="d-block">تاريخ بدء العمل</label>
                                </div>
                                <input type="date" class="form-control" name="business_start_date"/>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="funding_amount">Funding Amount</label>
                                    <label for="funding_amount" class="d-block">مبلغ التمويل</label>
                                </div>
                                <input type="number" step="0.01" class="form-control" name="funding_amount"/>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="profit_model">Profit Model</label>
                                    <label for="profit_model" class="d-block">نموذج الربح</label>
                                </div>
                                <textarea class="form-control" name="profit_model" rows="3"></textarea>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="previous_investments">Previous Investments</label>
                                    <label for="previous_investments" class="d-block">الاستثمارات السابقة</label>
                                </div>
                                <textarea class="form-control" name="previous_investments" rows="3"></textarea>
                            </div>

                            <!-- Documents -->
                            <h3 class="mb-3 mt-4">Documents</h3>
                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="business_plan">Business Plan</label>
                                    <label for="business_plan" class="d-block">خطة العمل</label>
                                </div>
                                <input type="file" class="form-control" name="business_plan"/>
                            </div>

                            <div class="form-group">
                                <div class="mb-2">
                                    <label for="pitch_deck">Pitch Deck</label>
                                    <label for="pitch_deck" class="d-block">عرض تقديمي</label>
                                </div>
                                <input type="file" class="form-control" name="pitch_deck"/>
                            </div>

                            <div class="form-group mt-4">
                                <button type="submit" class="btn btn-primary">Submit Application</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </t>
</template>


    <!-- Case Submission Success Template -->
    <template id="case_submitted" name="Case Submitted Successfully">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container mt32 mb32">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="alert alert-success text-center">
                                <h2>Thank you!</h2>
                                <p>Your application has been submitted successfully.</p>
                                <p>Reference Number: <strong><t t-out="case.name"/></strong></p>
                                <p>We will review your application and contact you soon.</p>
                                <div class="mt16">
                                    <a href="/case/form" class="btn btn-primary">Submit Another Application</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo> 