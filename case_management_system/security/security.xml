<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_case_management_system">
            <field name="name">Case Management System</field>
            <field name="sequence">60</field>
        </record>

        <record id="group_case_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_case_management_system"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_case_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="category_id" ref="module_case_management_system"/>
            <field name="implied_ids" eval="[(4, ref('group_case_user'))]"/>
        </record>

        <record id="group_case_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_case_management_system"/>
            <field name="implied_ids" eval="[(4, ref('group_case_supervisor'))]"/>
        </record>
    </data>
</odoo>
