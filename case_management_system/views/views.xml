<odoo>
    <data>
        <!-- Tree/List View -->
        <record id="view_case_tree" model="ir.ui.view">
            <field name="name">case.case.tree</field>
            <field name="model">case.case</field>
            <field name="arch" type="xml">
                <list string="Cases">
                    <field name="name" readonly="1"/>
                    <field name="contact_name"/>
                    <field name="project_name"/>
                    <field name="contact_email"/>
                    <field name="contact_phone"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_case_form" model="ir.ui.view">
            <field name="name">case.case.form</field>
            <field name="model">case.case</field>
            <field name="arch" type="xml">
                <form string="Case">
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Applicant Information">
                                <field name="contact_name"/>
                                <field name="contact_email"/>
                                <field name="contact_phone"/>
                                <field name="project_name"/>
                                <field name="project_description"/>
                            </group>
                            <group string="General Information">
                                <field name="business_nature"/>
                                <field name="sector_category"/>
                                <field name="business_registration_type"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Business Details">
                                <group>
                                    <group string="Business Information">
                                        <field name="problems_to_be_solved"/>
                                        <field name="offered_services"/>
                                        <field name="competitive_advantage"/>
                                        <field name="target_audience"/>
                                        <field name="challenges"/>
                                    </group>
                                    <group string="Financial Information">
                                        <field name="business_model"/>
                                        <field name="profit_model"/>
                                        <field name="previous_investments"/>
                                        <field name="funding_amount"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Dates">
                                <group>
                                    <field name="business_start_date"/>
                                    <field name="company_registration_date"/>
                                </group>
                            </page>
                            <page string="Documents">
                                <group>
                                    <group string="Business Plan">
                                        <field name="is_business_plan"/>
                                        <field name="business_plan" invisible="[('is_business_plan', '=', False)]"/>
                                    </group>
                                    <group string="General Info">
                                        <field name="is_general_info"/>
                                        <field name="general_info" invisible="[('is_general_info', '=', False)]"/>
                                    </group>
                                    <group string="Pitch Deck">
                                        <field name="is_pitch_deck"/>
                                        <field name="pitch_deck" invisible="[('is_pitch_deck', '=', False)]"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_case" model="ir.actions.act_window">
            <field name="name">Cases</field>
            <field name="res_model">case.case</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_cms_root"
                  name="CMS"
                  sequence="10"/>

        <menuitem id="menu_case_main"
                  name="Cases"
                  parent="menu_cms_root"
                  sequence="10"/>

        <menuitem id="menu_case"
                  name="Cases"
                  parent="menu_case_main"
                  action="action_case"
                  sequence="10"/>
    </data>
</odoo>
